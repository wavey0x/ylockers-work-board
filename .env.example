# A GitHub credential with read:project and access to the private source issues.
# Use a dedicated read-only credential. Never put it in a VITE_ variable.
BOARD_GITHUB_TOKEN=
GITHUB_ORG=yLockers
GITHUB_PROJECT_NUMBER=2
GITHUB_PROJECT_FIELD=Project
PUBLIC_PROJECTS=yFactory,yYB,yCRV,Resupply,Tools,Operations
# Generate a long random key for the protected Sync now control.
ADMIN_SYNC_TOKEN=
SYNC_INTERVAL_HOURS=1
PORT=8080
HOST=127.0.0.1
DATA_DIR=./data
