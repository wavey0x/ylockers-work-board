[Unit]
Description=Publish the filtered yLockers work board
Wants=network-online.target
After=network-online.target
OnFailure=ylockers-work-board-alert@%n.service

[Service]
Type=oneshot
User=ylockers-board
Group=ylockers-board
WorkingDirectory=/opt/ylockers-work-board
EnvironmentFile=/etc/ylockers-work-board.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=BOARD_DATA_DIR=/var/lib/ylockers-work-board
ExecStart=/usr/bin/env node /opt/ylockers-work-board/scripts/sync.mjs
StateDirectory=ylockers-work-board
StateDirectoryMode=0755
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ylockers-work-board
